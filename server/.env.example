PUBLIC_ORIGIN=http://localhost:8080
AUTH_ORIGIN=http://auth.localhost:8080
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8080
LOGTO_APP_ID=CONFIGURE_IN_LOGTO
LOGTO_RESOURCE=https://api.module-workspace.local
POSTGRES_PASSWORD=GENERATE
CORE_DB_PASSWORD=GENERATE
HASURA_DB_PASSWORD=GENERATE
LOGTO_DB_PASSWORD=GENERATE
N8N_DB_PASSWORD=GENERATE
INTERNAL_SECRET=GENERATE
HASURA_ADMIN_SECRET=GENERATE
CENTRIFUGO_SECRET=GENERATE
CENTRIFUGO_API_KEY=GENERATE
MINIO_ROOT_USER=module-workspace-storage
MINIO_ROOT_PASSWORD=GENERATE
N8N_ENCRYPTION_KEY=GENERATE
WORKFLOW_PATH=GENERATE
LOGTO_IMAGE=ghcr.io/logto-io/logto:1.41.0
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.43.7
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
MINIO_MC_IMAGE=pgsty/mc:RELEASE.2026-10-18T00-00-00Z

# Override these to reuse an existing deployment during upgrades.
CORE_DB_USER=module_workspace
CORE_DB_NAME=module_workspace
S3_BUCKET=module-workspace
DB_VOLUME_NAME=module-workspace_db-data
MINIO_VOLUME_NAME=module-workspace_minio-data
N8N_VOLUME_NAME=module-workspace_n8n-data
